[Unit]
Description=Lerd DNS (dnsmasq)
After=network.target
# The NetworkManager dispatcher restarts this unit on every interface event, so a
# resume that brings several links back at once outruns systemd's default start
# rate limit and parks lerd-dns in failed until the user runs `lerd start`. This
# only takes effect in [Unit]; systemd ignores it under [Service].
StartLimitIntervalSec=0

[Container]
Image=lerd-dnsmasq:v2
ContainerName=lerd-dns
PublishPort=127.0.0.1:5300:5300/udp
PublishPort=127.0.0.1:5300:5300/tcp
Volume=%h/.local/share/lerd/dnsmasq:/etc/dnsmasq.d:ro,z
Exec=lerd-dnsmasq --no-daemon --conf-dir=/etc/dnsmasq.d

[Service]
Restart=always
TimeoutStartSec=300
# A stop that outruns the 60s user@ window takes the whole logout down with
# it, so this caps the unit's own wait. StopTimeout= would be the podman-side
# half, but podman <5.0 aborts on that key and drops every unit (#299).
TimeoutStopSec=20

[Install]
WantedBy=default.target
